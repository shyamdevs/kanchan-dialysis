# API server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Comma-separated additional allowed frontend origins if needed
ALLOWED_ORIGINS=

# MongoDB Atlas/local connection
MONGODB_URI=mongodb://127.0.0.1:27017/kanchan_dialysis

# Use a unique random secret of 32+ characters. Example generator: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-before-deploying

# Initial admin account created only if this email does not already exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Required for persistent media uploads in the admin panel
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_MB=8
